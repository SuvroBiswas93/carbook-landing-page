  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "concurrently -k -n server,next -c blue,green \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "start:server": "tsx server/src/index.ts",
